{
  "name": "construkt-kit",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git"
  },
  "scripts": {
    "prepare": "turbo run codegen --filter=@construkt-kit/ui",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "oxlint packages apps --format=default",
    "lint:fix": "oxlint packages apps --format=default --fix",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "storybook": "turbo run storybook --filter @construkt-kit/storybook",
    "build-storybook": "turbo run build --filter @construkt-kit/storybook",
    "release": "pnpm build && pnpm check:css && pnpm check:deps && pnpm turbo run check:exports && node scripts/publish-packages.mjs",
    "update-deps": "pnpm update -r && pnpm update",
    "check:css": "node scripts/check-preset-css.mjs",
    "check:deps": "node scripts/check-deps.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@construkt-kit/config": "workspace:*",
    "known-css-properties": "^0.37.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.25",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.11.2"
}
