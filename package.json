{
  "name": "construkt-kit",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "node scripts/lint.mjs packages apps --threads=4 --format=default",
    "lint:fix": "node scripts/lint.mjs packages apps --threads=4 --format=default --fix",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "storybook": "turbo run storybook --filter @construkt-kit/storybook",
    "build-storybook": "turbo run build --filter @construkt-kit/storybook",
    "release": "pnpm build && pnpm turbo run check:exports && node scripts/publish-packages.mjs",
    "update-deps": "pnpm update -r && pnpm update"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@construkt-kit/config": "workspace:*",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.7.0"
}
