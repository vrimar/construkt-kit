{
  "name": "construkt-kit",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "turbo run codegen --filter=@construkt-kit/ui",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "test:stories": "turbo run test:stories --filter=@construkt-kit/storybook --",
    "test:stories:changed": "turbo run test:stories --filter=@construkt-kit/storybook -- --changed",
    "stories:accept": "story-kit accept",
    "stories:aria": "story-kit aria",
    "stories:browser": "story-kit browser",
    "stories:ids": "story-kit ids",
    "lint": "oxlint packages apps --format=default",
    "lint:fix": "oxlint packages apps --format=default --fix",
    "format": "oxfmt",
    "typecheck": "turbo run typecheck",
    "storybook": "turbo run storybook --filter @construkt-kit/storybook",
    "build-storybook": "turbo run build --filter @construkt-kit/storybook",
    "release": "pnpm release:check && node scripts/publish-packages.mjs",
    "release:check": "pnpm build && pnpm check:css && pnpm check:deps && pnpm turbo run check:exports",
    "release:prepare": "node scripts/release-prepare.mjs",
    "update-deps": "pnpm update -r && pnpm update",
    "check:css": "node scripts/check-preset-css.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:stories": "node scripts/check-stories.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@construkt-kit/config": "workspace:*",
    "@construkt-kit/story-kit": "workspace:*",
    "known-css-properties": "^0.37.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "publint": "^0.3.25",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.11.2"
}
