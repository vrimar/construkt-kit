{
  "name": "@construkt-kit/data-grid",
  "version": "0.2.0",
  "description": "Virtualized, Excel-like data grid for Construkt Kit apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git",
    "directory": "packages/data-grid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "default": "./dist/preset.mjs"
    }
  },
  "scripts": {
    "codegen": "panda codegen --clean",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "test": "vitest run --project core --project unit",
    "test:browser": "vitest run --project browser --project touch",
    "check:exports": "publint --strict && node ../../scripts/check-attw.mjs && node ../../scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@construkt-kit/config": "workspace:*",
    "@construkt-kit/story-kit": "workspace:*",
    "@construkt-kit/ui": "workspace:*",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/types": "^2.5.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "catalog:",
    "tsdown": "^0.23.7",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@construkt-kit/ui": ">=0.15.0",
    "@pandacss/dev": "^2.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
