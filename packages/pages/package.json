{
  "name": "@construkt-kit/pages",
  "version": "0.3.1",
  "private": false,
  "description": "Shared full-page components (login, register, forgot password) for Construkt Kit apps",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git",
    "directory": "packages/pages"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./panda.buildinfo.json": "./dist/panda.buildinfo.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && panda ship --outfile dist/panda.buildinfo.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt src",
    "check:exports": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@construkt-kit/utils": "workspace:*",
    "lucide-react": "^1.32.0"
  },
  "peerDependencies": {
    "@construkt-kit/ui": ">=0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@construkt-kit/config": "workspace:*",
    "@construkt-kit/preset": "workspace:*",
    "@construkt-kit/ui": "workspace:*",
    "@pandacss/dev": "^1.12.0",
    "@pandacss/preset-base": "^1.12.0",
    "@storybook/react-vite": "^10.5.9",
    "@types/react": "^19.2.18",
    "storybook": "^10.5.9",
    "tsdown": "^0.22.14"
  }
}
