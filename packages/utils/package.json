{
  "name": "@construkt-kit/utils",
  "version": "0.5.0",
  "private": false,
  "description": "Stateless, framework-agnostic utilities for Construkt Kit frontend apps",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git",
    "directory": "packages/utils"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt src",
    "check:exports": "publint --strict && node ../../scripts/check-attw.mjs"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@construkt-kit/config": "workspace:*",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  }
}
