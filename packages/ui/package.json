{
  "name": "@construkt-kit/ui",
  "version": "0.9.1",
  "private": false,
  "description": "Shared component library for Construkt Kit frontend apps",
  "author": "Vasil Rimar",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./layers.css": "./layers.css",
    "./panda/*": "./panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./recipes": {
      "types": "./styled-system/recipes/index.d.ts",
      "default": "./styled-system/recipes/index.js"
    },
    "./recipes/*": {
      "types": "./styled-system/recipes/*.d.ts",
      "default": "./styled-system/recipes/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "default": "./styled-system/jsx/index.js"
    },
    "./jsx/*": {
      "types": "./styled-system/jsx/*.d.ts",
      "default": "./styled-system/jsx/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    }
  },
  "imports": {
    "#styled-system/*": {
      "types": "./styled-system/*/index.d.ts",
      "default": "./styled-system/*/index.js"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "layers.css",
    "panda",
    "styled-system"
  ],
  "scripts": {
    "codegen": "panda codegen --clean && node ./scripts/patch-panda-jsx-types.mjs",
    "build": "tsdown && panda lib -o . --files \"./dist/*.mjs\"",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt src",
    "test": "vitest run",
    "check:exports": "publint --strict && node ../../scripts/check-attw.mjs --exclude-entrypoints ./layers.css && node ../../scripts/check-dist-exports.mjs && node ../../scripts/check-dist-types.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.3",
    "@construkt-kit/utils": "workspace:^",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.19",
    "lucide-react": "^1.56.0",
    "react-resizable-panels": "^4.14.5",
    "react-use": "^17.6.1"
  },
  "peerDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@pandacss/dev": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@fontsource-variable/inter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@construkt-kit/config": "workspace:*",
    "@construkt-kit/preset": "workspace:*",
    "@pandacss/dev": "^2.2.0",
    "@pandacss/eslint-plugin": "^2.2.0",
    "@pandacss/preset-base": "^2.2.0",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.2",
    "tsdown": "^0.23.1",
    "vitest": "^5.0.4"
  }
}
