{
  "name": "@construkt-kit/ui",
  "version": "0.4.0",
  "private": false,
  "description": "Shared component library for Construkt Kit frontend apps",
  "author": "Vasil Rimar",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "default": "./dist/preset.mjs"
    },
    "./panda": {
      "types": "./dist/panda.d.mts",
      "default": "./dist/panda.mjs"
    },
    "./panda.buildinfo.json": "./dist/panda.buildinfo.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "pnpm --filter @construkt-kit/styled-system build",
    "build": "tsdown && panda ship --outfile dist/panda.buildinfo.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt src",
    "test": "vitest run",
    "check:exports": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@ark-ui/react": "^5.38.2",
    "@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.0.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^2.1.0",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.32.0",
    "react-resizable-panels": "^4.12.3",
    "react-use": "^17.6.1",
    "ts-pattern": "^5.9.0"
  },
  "peerDependencies": {
    "@construkt-kit/preset": ">=0.4.0",
    "@pandacss/dev": "^1.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@construkt-kit/config": "workspace:*",
    "@construkt-kit/preset": "workspace:*",
    "@construkt-kit/styled-system": "workspace:*",
    "@pandacss/dev": "^1.12.0",
    "@pandacss/eslint-plugin": "^0.3.2",
    "@storybook/react-vite": "^10.5.9",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.9",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.11"
  }
}
