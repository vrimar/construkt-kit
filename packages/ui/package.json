{
  "name": "@construkt-kit/ui",
  "version": "0.14.0",
  "private": false,
  "description": "Shared component library for Construkt Kit frontend apps",
  "license": "MIT",
  "author": "Vasil Rimar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "panda",
    "styled-system",
    "codemods",
    "!codemods/*.test.ts",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "imports": {
    "#styled-system/*": {
      "types": "./styled-system/*/index.d.ts",
      "default": "./styled-system/*/index.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./panda/*": "./panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./recipes": {
      "types": "./styled-system/recipes/index.d.ts",
      "default": "./styled-system/recipes/index.js"
    },
    "./recipes/*": {
      "types": "./styled-system/recipes/*.d.ts",
      "default": "./styled-system/recipes/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "default": "./styled-system/jsx/index.js"
    },
    "./jsx/*": {
      "types": "./styled-system/jsx/*.d.ts",
      "default": "./styled-system/jsx/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    }
  },
  "scripts": {
    "codegen": "panda codegen --clean",
    "build": "tsdown && panda lib -o . --files \"./dist/*.mjs\"",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser --project touch",
    "check:exports": "publint --strict && node ../../scripts/check-attw.mjs && node ../../scripts/check-dist.mjs"
  },
  "dependencies": {
    "@construkt-kit/utils": "workspace:^",
    "@floating-ui/react-dom": "^2.1.9",
    "@internationalized/date": "^3.12.4",
    "@internationalized/number": "^3.6.9",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "lucide-react": "^1.73.0",
    "react-resizable-panels": "^4.24.0"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@construkt-kit/config": "workspace:*",
    "@construkt-kit/preset": "workspace:*",
    "@construkt-kit/story-kit": "workspace:*",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/eslint-plugin": "^2.5.0",
    "@pandacss/preset-base": "^2.5.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jscodeshift": "^17.4.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "catalog:",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@pandacss/dev": "^2.3.0",
    "inter-ui": "^4.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "inter-ui": {
      "optional": true
    }
  }
}
