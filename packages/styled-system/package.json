{
  "name": "@construkt-kit/styled-system",
  "version": "0.1.3",
  "private": true,
  "description": "Internal Panda CSS runtime for building @construkt-kit/ui. Not published — consuming apps generate their own via panda codegen.",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./css": {
      "types": "./dist/css/index.d.ts",
      "default": "./dist/css/index.mjs"
    },
    "./jsx": {
      "types": "./dist/jsx/index.d.ts",
      "default": "./dist/jsx/index.mjs"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "default": "./dist/patterns/index.mjs"
    },
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "default": "./dist/recipes/index.mjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "pnpm --filter @construkt-kit/preset build && panda codegen --clean && node ./scripts/patch-panda-jsx-types.mjs",
    "build": "panda codegen --clean && node ./scripts/patch-panda-jsx-types.mjs",
    "dev": "panda codegen --watch",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt ."
  },
  "devDependencies": {
    "@construkt-kit/config": "workspace:*",
    "@construkt-kit/preset": "workspace:*",
    "@pandacss/dev": "^1.12.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
