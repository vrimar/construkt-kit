{
  "name": "@construkt-kit/preset",
  "version": "0.8.0",
  "private": false,
  "description": "Shared Panda CSS preset for Construkt Kit frontend apps",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git",
    "directory": "packages/preset"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt src",
    "check:exports": "publint --strict && node ../../scripts/check-attw.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.3"
  },
  "peerDependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  },
  "peerDependenciesMeta": {
    "@fontsource-variable/inter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@construkt-kit/config": "workspace:*",
    "@pandacss/dev": "^2.2.0",
    "@pandacss/types": "^2.2.0",
    "tsdown": "^0.23.1"
  }
}
