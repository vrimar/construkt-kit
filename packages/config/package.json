{
  "name": "@construkt-kit/config",
  "version": "0.7.0",
  "description": "Shared tool configuration for all Construkt Kit frontend projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git",
    "directory": "packages/config"
  },
  "files": [
    "dist",
    "oxlint/construkt.mjs",
    "typescript"
  ],
  "type": "module",
  "exports": {
    "./typescript": "./typescript/base.json",
    "./vite": {
      "types": "./dist/vite/index.d.mts",
      "default": "./dist/vite/index.mjs"
    },
    "./playwright": {
      "types": "./dist/playwright/index.d.mts",
      "default": "./dist/playwright/index.mjs"
    },
    "./kubb": {
      "types": "./dist/kubb/index.d.mts",
      "default": "./dist/kubb/index.mjs"
    },
    "./oxlint": {
      "types": "./dist/oxlint/index.d.mts",
      "default": "./dist/oxlint/index.mjs"
    },
    "./oxlint/construkt": "./oxlint/construkt.mjs",
    "./oxfmt": {
      "types": "./dist/oxfmt/index.d.mts",
      "default": "./dist/oxfmt/index.mjs"
    },
    "./tsdown": {
      "types": "./dist/tsdown/index.d.mts",
      "default": "./dist/tsdown/index.mjs"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.mts",
      "default": "./dist/vitest/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "check:exports": "publint --strict && node ../../scripts/check-attw.mjs --exclude-entrypoints ./typescript ./oxlint/construkt",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json"
  },
  "devDependencies": {
    "@kubb/adapter-oas": "^5.20.2",
    "@kubb/plugin-fetch": "^6.0.4",
    "@kubb/plugin-react-query": "^5.10.4",
    "@kubb/plugin-ts": "^5.5.4",
    "@playwright/test": "catalog:",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "kubb": "^5.20.2",
    "tsdown": "^0.23.7",
    "vite": "^8.3.8",
    "vite-plugin-checker": "^1.0.0",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@kubb/adapter-oas": "^5.20.2",
    "@kubb/plugin-fetch": "^6.0.4",
    "@kubb/plugin-react-query": "^5.10.4",
    "@kubb/plugin-ts": "^5.5.4",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.0.5",
    "kubb": "^5.20.2",
    "oxfmt": ">=0.67.0 <1",
    "oxlint": "^1.79.0",
    "tsdown": ">=0.23.0 <1",
    "vite": "^8.2.1",
    "vite-plugin-checker": ">=0.14.5 <2"
  },
  "peerDependenciesMeta": {
    "@kubb/adapter-oas": {
      "optional": true
    },
    "@kubb/plugin-fetch": {
      "optional": true
    },
    "@kubb/plugin-react-query": {
      "optional": true
    },
    "@kubb/plugin-ts": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "kubb": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "tsdown": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-plugin-checker": {
      "optional": true
    }
  }
}
