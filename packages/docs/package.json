{
  "name": "@construkt-kit/docs",
  "version": "0.1.0",
  "description": "MDX docs engine for Construkt Kit sites: a build-time manifest with link checks, search, llms.txt, and the docs layout components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git",
    "directory": "packages/docs"
  },
  "bin": {
    "construkt-kit-docs": "./bin/docs.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    },
    "./mdx": {
      "types": "./dist/mdx.d.mts",
      "default": "./dist/mdx.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "default": "./dist/preset.mjs"
    }
  },
  "scripts": {
    "codegen": "panda codegen --clean",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "check:exports": "publint --strict && node ../../scripts/check-attw.mjs && node ../../scripts/check-dist.mjs"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.73.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.3",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tsx": "^4.23.15",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@construkt-kit/config": "workspace:*",
    "@construkt-kit/story-kit": "workspace:*",
    "@construkt-kit/ui": "workspace:*",
    "@mdx-js/mdx": "^3.1.1",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/types": "^2.5.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "catalog:",
    "tsdown": "^0.23.7",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@construkt-kit/ui": ">=0.16.1",
    "@pandacss/dev": "^2.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
