{
  "name": "@construkt-kit/api",
  "version": "0.4.0",
  "private": false,
  "description": "HTTP client, query factories, typed errors, and generated API types for Construkt Kit apps",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git",
    "directory": "packages/api"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit",
    "test": "vitest run",
    "format": "oxfmt src test",
    "gen:fixture": "node bin/api-gen.mjs --config test/api.config.ts --input test/fixtures/openapi.json",
    "check:exports": "publint --strict && node ../../scripts/check-attw.mjs"
  },
  "bin": {
    "construkt-kit-api-gen": "./bin/api-gen.mjs"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@construkt-kit/config": "workspace:*",
    "@construkt-kit/utils": "workspace:*",
    "@kubb/adapter-oas": "^5.9.0",
    "@kubb/plugin-fetch": "^5.5.11",
    "@kubb/plugin-react-query": "^5.3.3",
    "@kubb/plugin-ts": "^5.0.10",
    "@tanstack/react-query": "^5.104.2",
    "kubb": "^5.9.0",
    "tsdown": "^0.23.1",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "kubb": "^5.2.6"
  },
  "peerDependenciesMeta": {
    "kubb": {
      "optional": true
    }
  }
}
