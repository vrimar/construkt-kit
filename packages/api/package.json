{
  "name": "@construkt-kit/api",
  "version": "0.3.1",
  "private": false,
  "description": "HTTP client, query factories, typed errors, and generated API types for Construkt Kit apps",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrimar/construkt-kit.git",
    "directory": "packages/api"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit",
    "test": "vitest run",
    "format": "oxfmt src test",
    "gen:fixture": "node bin/api-gen.mjs --config test/api.config.ts --input test/fixtures/openapi.json",
    "check:exports": "publint --strict && attw --pack . --profile esm-only"
  },
  "bin": {
    "construkt-kit-api-gen": "./bin/api-gen.mjs"
  },
  "dependencies": {
    "kubb": "^5.2.6",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@construkt-kit/config": "workspace:*",
    "@construkt-kit/utils": "workspace:*",
    "@kubb/adapter-oas": "^5.2.6",
    "@kubb/plugin-fetch": "^5.4.1",
    "@kubb/plugin-react-query": "^5.1.2",
    "@kubb/plugin-ts": "^5.0.2",
    "@tanstack/react-query": "^5.90.2",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.0"
  }
}
