{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "env": ["CONSTRUKT_KIT_STORYBOOK_BASE_PATH"],
      "outputs": ["dist/**", "panda/**", "storybook-static/**"]
    },
    "check:exports": {
      "dependsOn": ["build"]
    },
    "dev": {
      "dependsOn": ["^build", "codegen"],
      "persistent": true
    },
    "gen:fixture": {
      "dependsOn": ["^build"],
      "inputs": ["bin/**", "test/api.config.ts", "test/fixtures/**"],
      "outputs": ["test/gen/**"]
    },
    "test": {
      "dependsOn": ["build", "gen:fixture"]
    },
    "codegen": {
      "dependsOn": ["^build"],
      "outputs": ["styled-system/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "codegen", "gen:fixture"]
    },
    "//#lint": {
      // Type-aware rules read each package's built types; these three pull in
      // every other package's build transitively.
      "dependsOn": ["@construkt-kit/ui#build", "@construkt-kit/pages#build", "@construkt-kit/api#build"],
      "inputs": [
        "oxlint.config.ts",
        "packages/*/src/**",
        "packages/*/bin/**",
        "packages/*/test/**",
        "!packages/*/test/gen/**",
        "packages/config/{oxlint,vite,playwright,kubb,oxfmt}/**",
        "packages/*/*.config.ts",
        "packages/*/oxlint-panda.mjs",
        "packages/*/vitest.setup.ts",
        "apps/*/.storybook/**",
        "apps/*/*.config.ts"
      ]
    },
    "format": {},
    "storybook": {
      "dependsOn": ["^build"],
      "persistent": true
    }
  }
}
