{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "env": ["CONSTRUKT_KIT_STORYBOOK_BASE_PATH"],
      "outputs": ["dist/**", "panda/**", "storybook-static/**"]
    },
    "check:exports": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/**"]
    },
    "dev": {
      "dependsOn": ["^build", "codegen"],
      "persistent": true
    },
    "gen:fixture": {
      "dependsOn": ["^build"],
      "inputs": ["bin/**", "test/api.config.ts", "test/fixtures/**"],
      "outputs": ["test/gen/**"]
    },
    "test": {
      "dependsOn": ["build", "gen:fixture"]
    },
    "test:browser": {
      "dependsOn": ["build"],
      "env": ["CONSTRUKT_KIT_BROWSER_ENGINES"],
      "passThroughEnv": ["CI", "PLAYWRIGHT_BROWSERS_PATH"]
    },
    "test:stories": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["CI", "GITHUB_*", "STORIES_*", "DOCKER_*", "HOME", "XDG_*"]
    },
    "codegen": {
      "dependsOn": ["^build"],
      "outputs": ["styled-system/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "codegen", "gen:fixture"]
    },
    "//#lint:oxlint": {
      // Type-aware rules read each package's built types and data-grid's and docs'
      // generated recipes; these pull in every other package's build transitively.
      "dependsOn": [
        "@construkt-kit/ui#build",
        "@construkt-kit/pages#build",
        "@construkt-kit/api#build",
        "@construkt-kit/testing#build",
        "@construkt-kit/data-grid#codegen",
        "@construkt-kit/docs#codegen"
      ],
      // Subtract only file types neither oxlint nor the type checker reads; a directory list misses new ones.
      "inputs": ["$TURBO_DEFAULT$", "!**/*.{md,png,svg,css,html,yml}"]
    },
    "storybook": {
      "dependsOn": ["^build"],
      "persistent": true
    }
  }
}
