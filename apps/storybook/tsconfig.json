{
  "extends": "@construkt-kit/config/typescript",
  "compilerOptions": {
    "paths": {
      "*": ["./*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "stories/**/*.tsx",
    ".storybook/**/*.d.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "tests/**/*.ts",
    "gallery/**/*.tsx",
    "gallery/**/*.ts",
    "*.ts"
  ]
}
