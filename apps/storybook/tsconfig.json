{
  "extends": "@construkt-kit/config/typescript",
  "compilerOptions": {
    "paths": {
      "*": ["./*"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "stories/**/*.tsx",
    ".storybook/**/*.d.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "tests/**/*.ts",
    "gallery/**/*.tsx",
    "gallery/**/*.ts",
    "*.ts",
    "../../packages/ui/src/**/*.stories.ts",
    "../../packages/ui/src/**/*.stories.tsx",
    "../../packages/pages/src/**/*.stories.ts",
    "../../packages/pages/src/**/*.stories.tsx",
    "../../packages/pages/src/**/*.spec.ts",
    "../../packages/data-grid/src/**/*.stories.ts",
    "../../packages/data-grid/src/**/*.stories.tsx"
  ]
}
